# Postgres connection used by the server (via Drizzle)
DATABASE_URL=postgres://media:media@localhost:5432/media

# Fastify server port
PORT=3000

# Host path to your media library. Bind-mounted read-only into the container
# at /media — this is the host side of that mount, not a container path.
MEDIA_ROOT=./media-placeholder

# Host path the in-app folder browser may look at, read-only. Defaults to
# your home folder, so you normally don't need to set this.
# HOME_ROOT=/home/you

# Host path for the one writable mount. Backups are written here, and
# anything you drop in is offered for restore.
BACKUP_DIR=../backups

# Writable directory for generated thumbnails/posters (holds thumbnails/ and posters/ subfolders)
APP_DATA_DIR=./app-data

# Which compose files a bare `docker compose` picks up. Without this, running
# `docker compose up -d` in docker/ uses the base file alone — which has no
# command for the development image, so the container exits immediately and
# restart-loops with no logs.
# Only set this for development. Leave it unset to run the normal build.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Where the browser thinks it is — comma-separated, for dev (5173) and prod
# (3000). One must match the address bar exactly or WebAuthn (Touch ID for
# discreet mode) is refused.
WEBAUTHN_ORIGIN=http://localhost:5173,http://localhost:3000
